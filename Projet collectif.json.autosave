mmonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetNumberVariable"},"parameters":["Height","=","Object.Height()"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["Object","Text","=","SubStr(FullText, 0, StrFindFrom(FullText, \" \", StrLength(TypedText) + 1))"]}],"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"NumberVariable"},"parameters":["Height","<","Object.Height()"]}],"actions":[{"type":{"value":"SetReturnBoolean"},"parameters":["True"]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["Object","Text","=","TypedText"]}]}],"variables":[{"folded":true,"name":"Height","type":"number","value":0.0}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"AutoTyping::AutoTyping","type":"behavior"}],"objectGroups":[]},{"fullName":"Clear forced line breaks","functionType":"Action","name":"ClearForcedLineBreak","private":true,"sentence":"Clear forced line breaks in _PARAM0_","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"SetStringVariable"},"parameters":["TypedText","=","SubStr(FullText, 0, StrLength(TypedText))"]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":"AutoTyping::AutoTyping","type":"behavior"}],"objectGroups":[]},{"fullName":"","functionType":"Action","name":"onDeActivate","sentence":"","events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"PauseObjectTimer"},"parameters":["Object","\"__AutoTyping.WriteTimer\""]}]}],"parameters":[{"description":"Object","name":"Object","type":"object"},{"description":"Behavior","name":"Behavior","supplementaryInformation":